# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random string, at least 32 characters, used to encrypt the admin session cookie
SESSION_SECRET="replace-this-with-a-random-string-of-at-least-32-characters"

# Used once by `npm run db:seed` to create the initial "dev" account. The dev
# role invites, disables and removes admin accounts from /dev/accounts, so no
# admin credentials are needed here. DEV_EMAIL is optional but lets the dev
# account use "Forgot password".
DEV_USERNAME="dev"
DEV_PASSWORD="change-me"
DEV_EMAIL=""

# Transactional email (account invites and password resets).
# Set EMAIL_PROVIDER=brevo plus a Brevo API key. If unset, emails are printed
# to the server console instead of being sent (handy for local development).
EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
EMAIL_FROM="no-reply@example.com"
EMAIL_FROM_NAME="Biher Salary"

# Optional: absolute origin used in emailed links (e.g. https://salary.example.com).
# If unset, the origin is taken from the incoming request's Host header.
APP_URL=""

# Support contact shown as a "Support" mailto link on the dashboards.
SUPPORT_EMAIL="support@example.com"
